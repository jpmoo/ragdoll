[Unit]
Description=RAGDoll MCP Server (Streamable HTTP / SSE)
After=network.target ragdoll-api.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/opt/ragdoll/env.ragdoll
EnvironmentFile=-/etc/default/ragdoll-ingest
# Transport/host/port come from env.ragdoll (RAGDOLL_MCP_TRANSPORT, default stdio).
# Set RAGDOLL_MCP_TRANSPORT=streamable-http there for remote clients.
# Do NOT hardcode Environment=RAGDOLL_MCP_TRANSPORT here: a unit-level Environment=
# is applied after EnvironmentFile= and would override env.ragdoll (and Python's
# config.setdefault can't recover it). Override via: systemctl edit ragdoll-mcp
#   [Service]
#   Environment="RAGDOLL_MCP_HOST=127.0.0.1"
#   Environment="RAGDOLL_MCP_PORT=9044"
#   WorkingDirectory=/opt/ragdoll
#   ExecStart=/opt/ragdoll/.venv/bin/python -m ragdoll_ingest.mcp_server

WorkingDirectory=/opt/ragdoll
ExecStart=/opt/ragdoll/.venv/bin/python -m ragdoll_ingest.mcp_server
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ragdoll-mcp

[Install]
WantedBy=multi-user.target
